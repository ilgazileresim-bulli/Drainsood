{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Cross-Origin-Opener-Policy", "value": "same-origin"},
        {"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' https://drainsood-chat-2026.mightypeach6.chatgpt.site"}
      ]
    },
    {
      "source": "/service.json",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"},
        {"key": "Access-Control-Allow-Origin", "value": "*"}
      ]
    },
    {
      "source": "/releases.json",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"},
        {"key": "Access-Control-Allow-Origin", "value": "*"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/indir/(.*)",
      "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]
    },
    {
      "source": "/site.css",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]
    },
    {
      "source": "/site.js",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]
    }
  ]
}
